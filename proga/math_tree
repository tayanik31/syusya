#include <iostream>
#include <stack>
#include<string>
using namespace std;
struct Node {
	char value;
	Node* left;
	Node* right;
};
Node* createnode(char v) {
	Node* node = new Node;
	node->value = v;
	node->left = NULL;
	node->right = NULL;
	return node;
}
bool isop(char c) {
	return c == '+' || c == '-' || c == '*' || c == '/';
}
//инфикс->постфикс
string topostfix(string infix) {
	string postfix;
	stack<char>ops;
	for (int i = 0; i < infix.length(); i++) {
		char c = infix[i];
		if (c >= 'a' && c <= 'z') { //операнд
			postfix += c;
		}
		else if (c == '(') {
			ops.push(c);
		}
		else if (c == ')') {
			while (ops.top() != '(') {
				postfix += ops.top();
				ops.pop();
			}
			ops.pop();
		}
		else if (isop(c)) {
			while (!ops.empty() && ops.top() != '(') {
				postfix += ops.top();
				ops.pop();
			}
			ops.push(c);
		}
	}
	while (!ops.empty()) {
		postfix += ops.top();
		ops.pop();
	}
	return postfix;
}
//дерево из постфикса
Node* buildtree(string postfix) {
	stack<Node*>st;
	for (int i = 0; i < postfix.length(); i++) {
		char c = postfix[i];
		Node* node = createnode(c);
		if (isop(c)) {
			node->right = st.top();
			st.pop();
			node->left = st.top();
			st.pop();
		}
		st.push(node);
	}
	return st.top();
}
//прямой обход(префикс)
void prefix(Node* root) {
	if (root == NULL)
		return;
	cout << root->value << " ";
	prefix(root->left);
	prefix(root->right);
}
//Обратных (постфикс)
void postfixorder(Node* root) {
	if (root == NULL)
		return;
	postfixorder(root->left);
	postfixorder(root->right);
	cout << root->value << " ";
}
int main() {
	setlocale(LC_ALL, "RUS");
	string infix;
	cout << "Введите математическое выражение: ";
	cin >> infix;
	cout << "\nВы ввели: " << infix << endl;
	string post = topostfix(infix);
	Node* root = buildtree(post);
	cout << "Префиксная форма: ";
	prefix(root);
	cout << endl;

	cout << "Постфиксная форма: ";
	postfixorder(root);
	cout << endl;

	return 0;
}
